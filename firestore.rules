rules_version = '2';

// Modelo de acesso do docs-hub (seção 5 do PLAN.md), testado em tests/rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // Sem documento users/{uid}, ou com ativo == false, não há nenhum acesso.
    function hasProfile() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('ativo', true) == true;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return hasProfile() && profile().role == 'admin';
    }
    function canSeeProduct(productId) {
      return isAdmin() ||
        (hasProfile() && productId in profile().get('produtosPermitidos', []));
    }
    function canReadArticle(a) {
      return isAdmin() ||
        (canSeeProduct(a.productId) &&
          a.status == 'published' &&
          (a.publico == 'usuario' || profile().get('verTecnico', false) == true));
    }
    function articleOf(articleId) {
      return get(/databases/$(database)/documents/articles/$(articleId)).data;
    }

    // Um usuário lê só o próprio perfil; só admins leem os demais e escrevem.
    match /users/{uid} {
      allow read: if isAdmin() || (hasProfile() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Configurações de cada pessoa (aside etc.): só o próprio dono lê e grava,
    // e só no formato esperado. Nem o admin lê as dos outros.
    function preferenciasValidas(d) {
      return d.keys().hasOnly(['aside', 'atualizadoEm']) &&
        d.aside is map &&
        d.aside.keys().hasOnly(['visivel', 'manual', 'busca']) &&
        d.aside.visivel is bool &&
        d.aside.manual is bool &&
        d.aside.busca is bool &&
        (!('atualizadoEm' in d) || d.atualizadoEm is number);
    }
    match /preferenciasUsuario/{uid} {
      allow read: if hasProfile() && request.auth.uid == uid;
      allow create, update: if hasProfile() && request.auth.uid == uid &&
        preferenciasValidas(request.resource.data);
      allow delete: if false;
    }

    // Unidades de negócio (BU): qualquer usuário ativo lê o nome para montar a
    // navegação; o acesso aos produtos continua sendo decidido em `blocks`.
    match /unidades/{unidadeId} {
      allow read: if hasProfile();
      allow write: if isAdmin();
    }

    // Resumo da última rodada de cada fonte de documentos (painel de
    // sincronização). Só o script de ingestão (Admin SDK) escreve.
    match /sincronizacoes/{fonteId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Registro dos arquivos de origem da ingestão (hash, estado, erro). Só admin;
    // quem escreve é o script de ingestão (Admin SDK).
    match /fontes/{fonteId} {
      allow read, write: if isAdmin();
    }

    match /blocks/{blockId} {
      allow read: if canSeeProduct(resource.data.productId);
      allow write: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if canReadArticle(resource.data);
      allow write: if isAdmin();

      // O leitor só pode somar 1 ao contador `views` e nada mais.
      allow update: if hasProfile() &&
        canReadArticle(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        request.resource.data.views == resource.data.views + 1;

      match /versions/{versionId} {
        allow read, write: if isAdmin();
      }

      // Alteração pendente de um artigo publicado: o conteúdo novo só é visto
      // por admins até ser aprovado e publicado.
      match /revisoes/{revisaoId} {
        allow read, write: if isAdmin();
      }

      // Comentários da revisão (pedidos de ajuste, aprovações).
      match /comentarios/{comentarioId} {
        allow read, write: if isAdmin();
      }

      // Sugestões da IA (doc-sync): só admins leem e decidem; a versão
      // publicada não muda até um admin aprovar.
      match /suggestions/{suggestionId} {
        allow read, write: if isAdmin();
      }

      // Contador diário: o leitor cria com 1 ou soma 1, sem poder ler.
      // `dia` repete o id do documento (AAAA-MM-DD) para a consulta agregada.
      match /viewsDaily/{day} {
        allow read, write: if isAdmin();
        allow create: if hasProfile() &&
          canReadArticle(articleOf(articleId)) &&
          request.resource.data.keys().hasOnly(['count', 'dia']) &&
          request.resource.data.dia == day &&
          request.resource.data.count == 1;
        allow update: if hasProfile() &&
          canReadArticle(articleOf(articleId)) &&
          request.resource.data.keys().hasOnly(['count', 'dia']) &&
          request.resource.data.dia == resource.data.dia &&
          request.resource.data.count == resource.data.count + 1;
      }
    }

    // Índice de busca agregado por produto: o leitor lê apenas os seus.
    match /searchIndex/{productId} {
      allow read: if canSeeProduct(productId);
      allow write: if isAdmin();

      // Quando o índice passa de ~800 KB, é dividido por subproduto.
      match /partes/{parteId} {
        allow read: if canSeeProduct(productId);
        allow write: if isAdmin();
      }
    }

    // Parte técnica do índice de busca: mesmo formato, mas só para quem pode
    // ver artigos técnicos. Sem isto o texto deles chegaria ao navegador de
    // qualquer leitor do produto (o filtro era só na tela).
    function canSeeTecnico(productId) {
      return isAdmin() ||
        (canSeeProduct(productId) && profile().get('verTecnico', false) == true);
    }
    match /searchIndexTecnico/{productId} {
      allow read: if canSeeTecnico(productId);
      allow write: if isAdmin();

      match /partes/{parteId} {
        allow read: if canSeeTecnico(productId);
        allow write: if isAdmin();
      }
    }

    // Buscas sem resultado: contador agregado por termo e produto. O leitor
    // só cria com 1 ou soma 1; apenas admins leem (painel de métricas).
    // Registros antigos não têm `productId`.
    match /searchMisses/{termoId} {
      allow read, write: if isAdmin();
      allow create: if hasProfile() &&
        request.resource.data.keys().hasOnly(['termo', 'count', 'ultimaVez', 'productId']) &&
        request.resource.data.termo is string &&
        request.resource.data.termo.size() <= 100 &&
        (!('productId' in request.resource.data) ||
          canSeeProduct(request.resource.data.productId)) &&
        request.resource.data.count == 1;
      allow update: if hasProfile() &&
        request.resource.data.keys().hasOnly(['termo', 'count', 'ultimaVez', 'productId']) &&
        request.resource.data.termo == resource.data.termo &&
        request.resource.data.get('productId', null) == resource.data.get('productId', null) &&
        request.resource.data.count == resource.data.count + 1;
    }

    // "Esta busca ajudou?": dois contadores (sim e não) por termo e produto,
    // sem dizer quem respondeu. O leitor só cria com um voto ou soma um voto
    // num dos dois; apenas admins leem.
    match /searchFeedback/{id} {
      allow read, write: if isAdmin();
      allow create: if hasProfile() &&
        request.resource.data.keys().hasOnly(['termo', 'productId', 'sim', 'nao', 'ultimaVez']) &&
        request.resource.data.termo is string &&
        request.resource.data.termo.size() <= 100 &&
        canSeeProduct(request.resource.data.productId) &&
        ((request.resource.data.sim == 1 && request.resource.data.nao == 0) ||
          (request.resource.data.sim == 0 && request.resource.data.nao == 1));
      allow update: if hasProfile() &&
        request.resource.data.keys().hasOnly(['termo', 'productId', 'sim', 'nao', 'ultimaVez']) &&
        request.resource.data.termo == resource.data.termo &&
        request.resource.data.productId == resource.data.productId &&
        canSeeProduct(resource.data.productId) &&
        ((request.resource.data.sim == resource.data.sim + 1 &&
            request.resource.data.nao == resource.data.nao) ||
          (request.resource.data.sim == resource.data.sim &&
            request.resource.data.nao == resource.data.nao + 1));
    }

    // Assistente de IA: só o servidor do assistente (Admin SDK) escreve os
    // contadores e o registro das perguntas. Admins leem tudo; o dono da
    // pergunta só pode marcar a própria resposta como útil ou ruim.
    match /assistenteUso/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /assistenteLog/{id} {
      allow read: if isAdmin();
      allow create, delete: if false;
      allow update: if hasProfile() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedback']) &&
        request.resource.data.feedback in ['util', 'ruim'];
    }

    // Auditoria: admins leem e criam; ninguém altera ou exclui.
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if false;
    }

    // Painel de métricas: o admin consulta viewsDaily de todos os artigos.
    match /{path=**}/viewsDaily/{day} {
      allow read: if isAdmin();
    }

    // Fila de sugestões pendentes: o admin consulta todos os artigos de uma vez.
    match /{path=**}/suggestions/{suggestionId} {
      allow read: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
